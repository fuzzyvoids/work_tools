\f0\b\fs48 \cf0 OTHER\
\pard\pardeftab720\sa298\partightenfactor0

\fs36 \cf0 Use 
\f7\fs39 read
\f0\fs36  as an alternative to the 
\f7\fs39 sleep
\f0\fs36  command\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Surprisingly, 
\f2\fs26 sleep
\f1\fs24  is an external command and not a 
\f2\fs26 bash
\f1\fs24  built-in.\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 CAVEAT:
\f1\b0  Requires 
\f2\fs26 bash
\f1\fs24  4+\

\f0\b Example Function:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 read_sleep() \{\
    # Usage: read_sleep 1\
    #        read_sleep 0.2\
    read -rt "$1" <> <(:) || :\
\}\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf0 \
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 Example Usage:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 read_sleep 1\
read_sleep 0.1\
read_sleep 30\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf0 \
\pard\pardeftab720\sa240\partightenfactor0
\cf0 For performance-critical situations, where it is not economic to open and close an excessive number of file descriptors, the allocation of a file descriptor may be done only once for all invocations of 
\f2\fs26 read
\f1\fs24 :\
(See the generic original implementation at {\field{\*\fldinst{HYPERLINK "https://blog.dhampir.no/content/sleeping-without-a-subprocess-in-bash-and-how-to-sleep-forever"}}{\fldrslt \cf3 \ul \ulc3 \strokec3 https://blog.dhampir.no/content/sleeping-without-a-subprocess-in-bash-and-how-to-sleep-forever}})\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 exec \{sleep_fd\}<> <(:)\
while some_quick_test; do\
    # equivalent of sleep 0.001\
