\f1\fs24 \cf0 \
\pard\pardeftab720\sa298\partightenfactor0

\f0\b\fs36 \cf0 Check if a program is in the user's PATH\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 # There are 3 ways to do this and either one can be used.\
type -p executable_name &>/dev/null\
hash executable_name &>/dev/null\
command -v executable_name &>/dev/null\
\
# As a test.\
if type -p executable_name &>/dev/null; then\
    # Program is in PATH.\
fi\
\
# Inverse.\
if ! type -p executable_name &>/dev/null; then\
    # Program is not in PATH.\
fi\
\
# Example (Exit early if program is not installed).\
if ! type -p convert &>/dev/null; then\
    printf '%s\\n' "error: convert is not installed, exiting..."\
    exit 1\
fi\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf0 \
\pard\pardeftab720\sa298\partightenfactor0

\f0\b\fs36 \cf0 Get the current date using 
\f7\fs39 strftime
\f0\fs36 \
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Bash\'92s 
\f2\fs26 printf
\f1\fs24  has a built-in method of getting the date which can be used in place of the 
\f2\fs26 date
\f1\fs24  command.\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 CAVEAT:
\f1\b0  Requires 
\f2\fs26 bash
\f1\fs24  4+\

\f0\b Example Function:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 date() \{\
    # Usage: date "format"\
    # See: 'man strftime' for format.\
    printf "%($1)T\\\\n" "-1"\
\}\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf0 \
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 Example Usage:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 # Using above function.\
$ date "%a %d %b  - %l:%M %p"\
Fri 15 Jun  - 10:00 AM\
\
# Using printf directly.\
$ printf '%(%a %d %b  - %l:%M %p)T\\n' "-1"\
Fri 15 Jun  - 10:00 AM\
\
# Assigning a variable using printf.\
$ printf -v date '%(%a %d %b  - %l:%M %p)T\\n' '-1'\
$ printf '%s\\n' "$date"\
Fri 15 Jun  - 10:00 AM\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf0 \
