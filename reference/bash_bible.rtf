\f1\fs24 \cf0 \
\pard\pardeftab720\sa298\partightenfactor0

\f0\b\fs36 \cf0 Generate a UUID V4\
\pard\pardeftab720\sa240\partightenfactor0

\fs24 \cf0 CAVEAT
\f1\b0 : The generated value is not cryptographically secure.\

\f0\b Example Function:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 uuid() \{\
    # Usage: uuid\
    C="89ab"\
\
    for ((N=0;N<16;++N)); do\
        B="$((RANDOM%256))"\
\
        case "$N" in\
            6)  printf '4%x' "$((B%16))" ;;\
            8)  printf '%c%x' "$\{C:$RANDOM%$\{#C\}:1\}" "$((B%16))" ;;\
\
            3|5|7|9)\
                printf '%02x-' "$B"\
            ;;\
\
            *)\
                printf '%02x' "$B"\
            ;;\
        esac\
    done\
\
    printf '\\n'\
\}\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf0 \
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 Example Usage:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 $ uuid\
d5b6c731-1310-4c24-9fe3-55d556d44374\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf0 \
\pard\pardeftab720\sa298\partightenfactor0

\f0\b\fs36 \cf0 Progress bars\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 This is a simple way of drawing progress bars without needing a for loop in the function itself.\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 Example Function:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 bar() \{\
    # Usage: bar 1 10\
    #            ^----- Elapsed Percentage (0-100).\
    #               ^-- Total length in chars.\
    ((elapsed=$1*$2/100))\
\
    # Create the bar with spaces.\
    printf -v prog  "%$\{elapsed\}s"\
    printf -v total "%$(($2-elapsed))s"\
\
    printf '%s\\r' "[$\{prog// /-\}$\{total\}]"\
\}\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf0 \
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 Example Usage:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 for ((i=0;i<=100;i++)); do\
    # Pure bash micro sleeps (for the example).\
    (:;:) && (:;:) && (:;:) && (:;:) && (:;:)\
\
    # Print the bar.\
    bar "$i" "10"\
done\
\
printf '\\n'\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf0 \
\pard\pardeftab720\sa298\partightenfactor0

\f0\b\fs36 \cf0 Get the list of functions in a script\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 get_functions() \{\
    # Usage: get_functions\
    IFS=$'\\n' read -d "" -ra functions < <(declare -F)\
    printf '%s\\n' "$\{functions[@]//declare -f \}"\
\}\
\pard\pardeftab720\partightenfactor0

