\f0\b \cf0 Example Function:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 dirname() \{\
    # Usage: dirname "path"\
    local tmp=$\{1:-.\}\
\
    [[ $tmp != *[!/]* ]] && \{\
        printf '/\\n'\
        return\
    \}\
\
    tmp=$\{tmp%%"$\{tmp##*[!/]\}"\}\
\
    [[ $tmp != */* ]] && \{\
        printf '.\\n'\
        return\
    \}\
\
    tmp=$\{tmp%/*\}\
    tmp=$\{tmp%%"$\{tmp##*[!/]\}"\}\
\
    printf '%s\\n' "$\{tmp:-/\}"\
\}\
