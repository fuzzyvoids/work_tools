\f2\b0\fs26 \cf0 # Normal method\
f()\{ echo hi;\}\
\
# Using a subshell\
f()(echo hi)\
\
# Using arithmetic\
# This can be used to assign integer values.\
# Example: f a=1\
#          f a++\
f()(($1))\
\
# Using tests, loops etc.\
# NOTE: \'91while\'92, \'91until\'92, \'91case\'92, \'91(())\'92, \'91[[]]\'92 can also be used.\
f()if true; then echo "$1"; fi\
f()for i in "$@"; do echo "$i"; done\
