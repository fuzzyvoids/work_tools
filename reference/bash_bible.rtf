\fs36 \cf0 Reverse an array\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Enabling 
\f2\fs26 extdebug
\f1\fs24  allows access to the 
\f2\fs26 BASH_ARGV
\f1\fs24  array which stores the current function\'92s arguments in reverse.\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 CAVEAT
\f1\b0 : Requires 
\f2\fs26 shopt -s compat44
\f1\fs24  in 
\f2\fs26 bash
\f1\fs24  5.0+.\

\f0\b Example Function:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 reverse_array() \{\
    # Usage: reverse_array "array"\
    shopt -s extdebug\
    f()(printf '%s\\n' "$\{BASH_ARGV[@]\}"); f "$@"\
    shopt -u extdebug\
\}\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf0 \
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 Example Usage:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 $ reverse_array 1 2 3 4 5\
5\
4\
3\
2\
1\
\
$ arr=(red blue green)\
$ reverse_array "$\{arr[@]\}"\
green\
blue\
red\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf0 \
\pard\pardeftab720\sa298\partightenfactor0

\f0\b\fs36 \cf0 Remove duplicate array elements\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Create a temporary associative array. When setting associative array values and a duplicate assignment occurs, bash overwrites the key. This allows us to effectively remove array duplicates.\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 CAVEAT:
\f1\b0  Requires 
\f2\fs26 bash
\f1\fs24  4+\

\f0\b CAVEAT:
\f1\b0  List order may not stay the same.\

\f0\b Example Function:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 remove_array_dups() \{\
    # Usage: remove_array_dups "array"\
    declare -A tmp_array\
\
    for i in "$@"; do\
        [[ $i ]] && IFS=" " tmp_array["$\{i:- \}"]=1\
    done\
\
    printf '%s\\n' "$\{!tmp_array[@]\}"\
\}\
