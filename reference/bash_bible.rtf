\f0\b\fs36 \cf0 Percent-encode a string\
\pard\pardeftab720\sa240\partightenfactor0

\fs24 \cf0 Example Function:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 urlencode() \{\
    # Usage: urlencode "string"\
    local LC_ALL=C\
    for (( i = 0; i < $\{#1\}; i++ )); do\
        : "$\{1:i:1\}"\
        case "$_" in\
            [a-zA-Z0-9.~_-])\
                printf '%s' "$_"\
            ;;\
\
            *)\
                printf '%%%02X' "'$_"\
            ;;\
        esac\
    done\
    printf '\\n'\
\}\
\pard\pardeftab720\partightenfactor0

\f1\fs24 \cf0 \
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 Example Usage:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

