\fs36 \cf0 Get the terminal size in lines and columns (
\f4\i from a script
\f0\i0 )\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 This is handy when writing scripts in pure bash and 
\f2\fs26 stty
\f1\fs24 /
\f2\fs26 tput
\f1\fs24  can\'92t be called.\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 Example Function:
\f1\b0 \
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 get_term_size() \{\
    # Usage: get_term_size\
\
    # (:;:) is a micro sleep to ensure the variables are\
    # exported immediately.\
    shopt -s checkwinsize; (:;:)\
    printf '%s\\n' "$LINES $COLUMNS"\
\}\
\pard\pardeftab720\partightenfactor0

