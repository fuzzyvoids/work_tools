\f1\fs24 \cf0 \
\pard\pardeftab720\sa298\partightenfactor0

\f0\b\fs36 \cf0 Capture the return value of a function without command substitution\
\pard\pardeftab720\sa240\partightenfactor0

\fs24 \cf0 CAVEAT:
\f1\b0  Requires 
\f2\fs26 bash
\f1\fs24  4+\
This uses local namerefs to avoid using 
\f2\fs26 var=$(some_func)
\f1\fs24  style command substitution for function output capture.\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 to_upper() \{\
  local -n ptr=$\{1\}\
\
  ptr=$\{ptr^^\}\
\}\
\
foo="bar"\
to_upper foo\
printf "%s\\n" "$\{foo\}" # BAR\
}